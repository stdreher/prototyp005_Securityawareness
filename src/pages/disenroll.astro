export const prerender = true;

import Base from "../layouts/Base.astro";
import schoolConfig from "../../school.config";
---

<Base title="Abmelden" description="Setze deinen Fortschritt zurück oder melde dich von der Schule ab.">
  <div class="mb-6">
    <a href="/" class="text-sm text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">
      &larr; Alle Lektionen
    </a>
  </div>

  <header class="mb-8">
    <h1 class="text-3xl font-bold">Abmelden</h1>
  </header>

  <div id="no-enrollment" class="hidden">
    <p class="text-gray-600 dark:text-stone-400">Du bist gerade nicht eingeschrieben. <a href="/" class="underline">Geh zur Startseite</a>, um dich einzuschreiben.</p>
  </div>

  <div id="enrolled-options" class="hidden">
    <!-- Reset progress (primary action) -->
    <div class="mb-8 p-6 border border-gray-200 dark:border-stone-700 rounded-lg">
      <h2 class="text-xl font-semibold mb-2">Fortschritt zurücksetzen</h2>
      <p class="text-gray-600 dark:text-stone-400 mb-4">Lösche alle abgeschlossenen Lektionen und Übungen, damit du sie noch einmal machen kannst. Deine Schüler-ID und dein Profil bleiben erhalten.</p>
      <div id="reset-confirm">
        <button
          id="reset-button"
          class="px-4 py-2 rounded-md text-sm font-medium bg-orange-600 text-white hover:bg-orange-700 transition-colors"
        >
          Fortschritt zurücksetzen
        </button>
      </div>
      <div id="reset-done" class="hidden">
        <p class="text-gray-600 dark:text-stone-400">Der Fortschritt wurde zurückgesetzt. Deine Schüler-ID bleibt gleich. <a href="/" class="underline">Geh zur Startseite</a>, um neu zu starten.</p>
      </div>
      <div id="reset-error" class="hidden">
        <p class="text-red-600 dark:text-red-400">Beim Zurücksetzen ist etwas schiefgelaufen. Versuch es noch einmal oder melde dich stattdessen komplett ab.</p>
      </div>
    </div>

    <!-- Disenroll (secondary/destructive action) -->
    <div class="p-6 border border-gray-200 dark:border-stone-700 rounded-lg">
      <h2 class="text-xl font-semibold mb-2">Komplett abmelden</h2>
      <p class="text-gray-600 dark:text-stone-400 mb-4">Entfernt deine Schüler-ID, deinen Fortschritt und deine Theme-Farbe aus diesem Browser. Deine Daten auf dem Server bleiben unberührt. Du musst dich neu einschreiben, um die {schoolConfig.name} wieder zu nutzen.</p>
      <div id="disenroll-confirm">
        <button
          id="disenroll-button"
          class="px-4 py-2 rounded-md text-sm font-medium border border-red-300 dark:border-red-700 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950 transition-colors"
        >
          Von dieser Schule abmelden
        </button>
      </div>
      <div id="disenroll-done" class="hidden">
        <p class="text-gray-600 dark:text-stone-400">Du wurdest abgemeldet. Weiterleitung zur Startseite&hellip;</p>
        </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var studentId = localStorage.getItem("studentId");
      if (!studentId) {
        document.getElementById("no-enrollment").classList.remove("hidden");
        return;
      }

      document.getElementById("enrolled-options").classList.remove("hidden");

      // Reset progress
      document.getElementById("reset-button").addEventListener("click", function () {
        var btn = this;
        btn.disabled = true;
        btn.textContent = "Wird zurückgesetzt\u2026";

        fetch("/api/progress/" + encodeURIComponent(studentId), {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reset: true }),
        })
          .then(function (res) {
            if (!res.ok) throw new Error("Reset failed");
            return res.json();
          })
          .then(function (progress) {
            localStorage.setItem("progress", JSON.stringify(progress));
            document.getElementById("reset-confirm").classList.add("hidden");
            document.getElementById("reset-done").classList.remove("hidden");
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = "Fortschritt zurücksetzen";
            document.getElementById("reset-error").classList.remove("hidden");
          });
      });

      // Disenroll
      document.getElementById("disenroll-button").addEventListener("click", function () {
        localStorage.removeItem("studentId");
        localStorage.removeItem("themeColor");
        localStorage.removeItem("progress");
        document.getElementById("disenroll-confirm").classList.add("hidden");
        document.getElementById("disenroll-done").classList.remove("hidden");
        setTimeout(function () {
          window.location.replace("/");
        }, 1500);
      });
    })();
  </script>

  <noscript>
    <p>Für diese Seite wird JavaScript benötigt. Bitte aktiviere es und versuch es erneut.</p>
  </noscript>
</Base>
